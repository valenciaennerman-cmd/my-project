# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# --- Card recognition -------------------------------------------------------
# Which backend reads the screenshot: "anthropic" (cloud, paid, accurate) or
# "ollama" (local, free, needs a vision-capable model).
VISION_BACKEND=anthropic

# -- anthropic backend --
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Haiku is the cheap default; swap for a larger model if it misreads cards.
VISION_MODEL=claude-haiku-4-5

# -- ollama backend --
OLLAMA_HOST=http://localhost:11434
# IMPORTANT: this must be a model that can see images. Check with
#   ollama show <model>
# and look for "vision" under capabilities. A text-only model (qwen3:30b-a3b,
# qwen3-coder, llama3.2) answers an image request with HTTP 400.
# Known-good on this machine: qwen3.5:0.8b
# Better if you pull one: qwen3-vl:8b, qwen2.5vl:7b
OLLAMA_MODEL=qwen3.5:0.8b
# Thinking mode. Slower per card; measure before turning it on.
OLLAMA_THINK=false
OLLAMA_TIMEOUT=180

# --- Watched folder --------------------------------------------------------
# Folder to watch for new screenshots. Defaults to your Windows Screenshots
# folder. Only files that appear AFTER the app starts are processed.
WATCH_DIR=C:\Users\etemk\Pictures\Screenshots

# File extensions to pick up (comma separated).
WATCH_EXTENSIONS=.png,.jpg,.jpeg

# --- Clipboard ------------------------------------------------------------
# With this on, Win+Shift+S a card and it is priced without saving a file.
CLIPBOARD_ENABLED=true
CLIPBOARD_POLL_INTERVAL=1.2

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8027

# --- Prices ----------------------------------------------------------------
# Order matters: the first provider that returns a price wins.
# futwiz = PC transfer market (what you want as a PC player)
# futgg  = console (PS/Xbox) market -- clearly labelled as such in the UI
PRICE_PROVIDERS=futwiz,futgg

# How long a fetched price stays fresh, in seconds.
PRICE_CACHE_TTL=420

# Be gentle with the sources: minimum seconds between two browser page loads.
BROWSER_MIN_INTERVAL=6.0

# Seconds to wait for a Cloudflare interstitial to clear before giving up.
BROWSER_CHALLENGE_TIMEOUT=25.0

# Run the price browser headless? Measured on FUTWIZ: headless clears the
# bot check once and is blocked on every load after that, while a normal
# window clears each one in ~1.3s. Leave this false unless you are running
# somewhere without a desktop.
BROWSER_HEADLESS=false

# Park that window off-screen so it never steals focus while you play.
BROWSER_OFFSCREEN=true

# --- EA market -------------------------------------------------------------
# EA takes 5% tax on every sale. Used to show your net payout.
EA_TAX_RATE=0.05
